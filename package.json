{
  "name": "factify",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Prototipo de verificación de noticias — React + Vite frontend, backend serverless TypeScript",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:vercel": "vercel dev",
    "build": "npm run build --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('frontend/node_modules',{recursive:true,force:true});\"",
    "test:evaluation": "npx tsx scripts/run-evaluation.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "@supabase/supabase-js": "^2.56.1",
    "@huggingface/inference": "^4.13.19"
  }
}
